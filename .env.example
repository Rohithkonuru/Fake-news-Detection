# TruthLens — AI-Powered News & Claim Verification System
# Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
DEBUG=true

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/truthlens
DATABASE_NAME=truthlens_db

# JWT Authentication Secret Key (Generate a random 32+ char secret in production)
JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# External API Integrations (Optional, system has built-in fallbacks)
GOOGLE_FACT_CHECK_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Search Timeouts and Rate Limits
SEARCH_TIMEOUT_SECONDS=8.0
MAX_CLAIMS_PER_ARTICLE=5
MAX_EVIDENCE_PER_CLAIM=6

# Frontend API URL (for Vite)
VITE_API_URL=http://127.0.0.1:8000/api
